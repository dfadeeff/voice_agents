# Cloud production profile — Deepgram + OpenAI + Cartesia
STT_PROVIDER=deepgram
LLM_PROVIDER=openai
TTS_PROVIDER=cartesia

# Language
LANGUAGE=de

# API keys (required)
DEEPGRAM_API_KEY=your-deepgram-key
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o

# Cartesia TTS — lowest first-audio latency. voice_id is required and must be a
# multilingual (German-capable) voice from the Cartesia dashboard.
CARTESIA_API_KEY=your-cartesia-key
CARTESIA_VOICE_ID=your-german-voice-id
CARTESIA_MODEL=sonic-2

# Alternative cloud TTS: ElevenLabs (more natural, higher latency)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your-elevenlabs-key

# Server
HOST=0.0.0.0
PORT=8000
DB_URL=sqlite+aiosqlite:///data/voice_agent.db

# Twilio (for real phone calls)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
