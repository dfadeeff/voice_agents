# Cloud production profile — Deepgram + OpenAI + ElevenLabs
STT_PROVIDER=deepgram
LLM_PROVIDER=openai
TTS_PROVIDER=elevenlabs

# Language
LANGUAGE=de

# API keys (required)
DEEPGRAM_API_KEY=your-deepgram-key
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=your-elevenlabs-key

# Server
HOST=0.0.0.0
PORT=8000
DB_URL=sqlite+aiosqlite:///data/voice_agent.db

# Self-improving loop (enabled in cloud)
EVALUATOR_ENABLED=true
EVALUATOR_PROVIDER=openai
EVALUATOR_MODEL=gpt-4o-mini
ADMIN_API_KEY=change-this-to-a-secure-key

# Twilio (for real phone calls)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
