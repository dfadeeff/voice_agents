# Provider selection (local defaults — no API keys needed)
STT_PROVIDER=whisper
LLM_PROVIDER=ollama
TTS_PROVIDER=piper

# Language (de = German, en = English)
LANGUAGE=de

# Whisper (local STT)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Piper (local TTS — German female voice)
PIPER_MODEL_PATH=models/piper/de_DE-eva_k-x_low.onnx

# Tool calling for local models (qwen2.5:7b recommended for speed; qwen3:4b for reasoning)
USE_TOOLS_LOCAL=true

# Server
HOST=0.0.0.0
PORT=8000
DB_URL=sqlite+aiosqlite:///data/voice_agent.db

# --- Cloud providers (uncomment and set keys) ---
# STT_PROVIDER=deepgram
# LLM_PROVIDER=openai
# TTS_PROVIDER=elevenlabs
#
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ELEVENLABS_API_KEY=

# --- Twilio (optional, for real phone calls) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Self-improving loop (disabled by default for local demo) ---
# EVALUATOR_ENABLED=false
# EVALUATOR_PROVIDER=ollama
# EVALUATOR_MODEL=qwen3:4b
# ADMIN_API_KEY=
