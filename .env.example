# Provider selection (local defaults — no API keys needed)
STT_PROVIDER=whisper
LLM_PROVIDER=ollama
TTS_PROVIDER=piper

# Whisper (local STT)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Piper (local TTS)
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx

# Enable tool calling for local models (requires qwen2.5, NOT llama3.1)
# USE_TOOLS_LOCAL=true

# Server
HOST=0.0.0.0
PORT=8000
DB_URL=sqlite+aiosqlite:///data/voice_agent.db

# --- Cloud providers (for better quality — uncomment and set keys) ---
# To switch to cloud: change the PROVIDER vars above and set API keys below.
#
# STT_PROVIDER=deepgram
# LLM_PROVIDER=openai
# TTS_PROVIDER=elevenlabs
#
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ELEVENLABS_API_KEY=

# --- Twilio (optional, for real phone calls) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
