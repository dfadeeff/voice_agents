# Provider selection (local defaults — no API keys needed)
STT_PROVIDER=whisper
LLM_PROVIDER=ollama
TTS_PROVIDER=piper

# Language (de = German, en = English)
LANGUAGE=de

# Whisper (local STT) — small is ~2x faster than medium on CPU; use medium for max accuracy
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Piper (local TTS — German female voice)
PIPER_MODEL_PATH=models/piper/de_DE-eva_k-x_low.onnx

# Tool calling for local models (qwen2.5:7b recommended; qwen3:4b is ~0.3s faster, less reliable tools)
USE_TOOLS_LOCAL=true

# Server
HOST=0.0.0.0
PORT=8000
DB_URL=sqlite+aiosqlite:///data/voice_agent.db

# --- Cloud providers (uncomment and set keys) ---
# STT_PROVIDER=deepgram
# LLM_PROVIDER=openai
# TTS_PROVIDER=cartesia        # or: elevenlabs
#
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# Cartesia (lowest-latency cloud TTS; voice_id must be German-capable):
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-2
# ElevenLabs (alternative cloud TTS):
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=          # a German voice from the ElevenLabs Voice Library
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Twilio (optional, for real phone calls) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
